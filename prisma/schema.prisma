// Schéma Prisma — Consolidation des données de collecte de déchets
// Base : SQLite (fichier local, adapté au POC / petite structure)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Référentiel véhicules (import "Immatriculations")
model Vehicule {
  immatriculation String @id
  fonction        String

  @@map("vehicules")
}

/// Pesées (imports "Sytraival" et "Serfim")
model Pesee {
  id              Int      @id @default(autoincrement())
  date            DateTime
  immatriculation String
  produit         String
  poidsNet        Float

  @@index([date])
  @@index([immatriculation])
  @@map("pesees")
}

/// Suivi véhicule : kilométrage et carburant (imports "Kilomètres" et "Carburant")
model SuiviVehicule {
  id              Int      @id @default(autoincrement())
  date            DateTime
  immatriculation String
  distanceKm      Float?
  litresCarburant Float?

  @@index([date])
  @@index([immatriculation])
  @@map("suivi_vehicules")
}

/* ---------------------------------------------------------------------
   Module Déchèteries
--------------------------------------------------------------------- */

model DechetteriePassage {
  id                String   @id @default(cuid())
  datePassage       DateTime
  site              String
  typeUsager        String?
  periodeReference  String

  @@index([datePassage])
  @@index([site])
  @@map("dechetterie_passages")
}

model DechetterieFlux {
  id                String   @id @default(cuid())
  dateCollecte      DateTime
  periodeReference  String
  site              String
  categorieFlux     String // Valeurs : "PAYANT" ou "REP"
  prestataire       String
  matiere           String
  poidsTonnes       Float

  @@index([dateCollecte])
  @@index([site])
  @@index([prestataire])
  @@map("dechetterie_flux")
}

/* ---------------------------------------------------------------------
   Tables d'Indicateurs (Agrégations KPI)
   Format de periodeReference : "2026-05", "2026-T1", "2026-ANNUEL", "GLOBALE"
--------------------------------------------------------------------- */

/// KPIs du module OMR (ex: Total Bio-déchets mensuel, Parc Bacs OMR global)
model OmrIndicateur {
  id               String @id @default(cuid())
  periodeReference String
  indicateur       String // ex: "TOTAL_BIODECHETS", "PARC_BACS_PARTICULIERS"
  valeur           Float

  @@unique([periodeReference, indicateur])
  @@map("omr_indicateurs")
}

/// KPIs du module RI
model RiIndicateur {
  id               String @id @default(cuid())
  periodeReference String
  indicateur       String
  valeur           Int    // Entier car ce sont des nombres de clients/mouvements

  @@unique([periodeReference, indicateur])
  @@map("ri_indicateurs")
}

/// KPIs du module Collecte Sélective
model CsIndicateur {
  id               String @id @default(cuid())
  periodeReference String
  indicateur       String
  valeur           Float  // Float car ce sont des tonnages ou carburant

  @@unique([periodeReference, indicateur])
  @@map("cs_indicateurs")
}
